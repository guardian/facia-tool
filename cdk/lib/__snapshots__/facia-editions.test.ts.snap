    "PublishedEditionUpdateSQSPolicy": {
      "Properties": {
        "PolicyDocument": {
          "Id": "sqs-sendmessage",
          "Statement": [
            {
              "Action": [
                "SQS:SendMessage",
              ],
              "Condition": {
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Ref": "PublishedEditionUpdateTopic",
                  },
                },
              },
              "Effect": "Allow",
              "Principal": {
                "AWS": "*",
              },
              "Resource": {
                "Fn::GetAtt": [
                  "PublishedEditionUpdateQueue",
                  "Arn",
                ],
              },
              "Sid": "allow-sqs-sendmessage",
            },
          ],
        },
        "Queues": [
