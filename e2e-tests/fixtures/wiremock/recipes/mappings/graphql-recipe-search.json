  "request": {
    "method": "POST",
    "urlPath": "/graphql",
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.operationName == 'FaciaRecipeSearch')]" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "bodyFileName": "graphql-recipe-search.json"
  }
}
